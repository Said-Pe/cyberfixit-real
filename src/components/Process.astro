---
const steps = [
  {
    number: '01',
    badge: 'Paso 1',
    title: 'Contacto Rápido',
    description: 'Escríbenos por WhatsApp y cuéntanos la falla de tu equipo. Sin formularios eternos ni esperas telefónicas.',
    highlight: 'Respuesta en < 15 min',
    icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z'
  },
  {
    number: '02',
    badge: 'Paso 2',
    title: 'Diagnóstico',
    description: 'Recibimos tu equipo en taller o mediante retiro express. Evaluamos los componentes y te damos presupuesto cerrado antes de intervenir.',
    highlight: 'Diagnóstico',
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4'
  },
  {
    number: '03',
    badge: 'Paso 3',
    title: 'Reparación & Pruebas',
    description: 'Ejecuto la reparación con repuestos de calidad y realizo pruebas de estrés para certificar su estabilidad.',
    highlight: 'Pruebas de Estrés',
    icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z'
  },
  {
    number: '04',
    badge: 'Paso 4',
    title: 'Entrega con Garantía cuando aplica',
    description: 'Recibes tu equipo impecable, funcionando al 100%.',
    highlight: 'Garantía',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z'
  },
];
---

<section id="proceso" class="relative overflow-hidden border-y border-white/5 bg-tech-black/60 py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <h2 class="mt-4 font-display text-3xl font-black text-white sm:text-4xl lg:text-5xl">
        ¿Cómo <span class="text-neon-green text-glow">Funciona?</span>
      </h2>
      <p class="mt-4 text-base leading-relaxed text-white/70 sm:text-lg">
        Un proceso claro, seguro y sin sorpresas. Tú siempre tienes el control antes de autorizar cualquier reparación.
      </p>
    </div>

    <!-- Timeline con layout responsivo -->
    <ol class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 relative">
      {steps.map((step, i) => (
        <li
          data-reveal
          style={`transition-delay: ${i * 80}ms`}
          class="relative flex flex-col justify-between rounded-xl border border-white/10 bg-card-bg/80 p-6 backdrop-blur-sm transition-all duration-300 hover:border-neon-green/60 hover:bg-card-bg"
        >
          <div>
            <!-- Header del paso con número y badge -->
            <div class="flex items-center justify-between">
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-dark-purple/40 border border-neon-green/40 font-mono text-sm font-bold text-neon-green">
                {step.number}
              </span>
              <span class="rounded bg-white/5 px-2 py-1 text-[11px] font-semibold uppercase tracking-wider text-neon-green border border-white/5">
                {step.badge}
              </span>
            </div>

            <!-- Título y descripción -->
            <h3 class="mt-5 font-display text-lg font-bold text-white">
              {step.title}
            </h3>
            <p class="mt-2.5 text-sm leading-relaxed text-white/65">
              {step.description}
            </p>
          </div>

          <!-- Highlight inferior -->
          <div class="mt-6 pt-4 border-t border-white/10 flex items-center gap-2 text-xs font-semibold text-neon-green">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>{step.highlight}</span>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

