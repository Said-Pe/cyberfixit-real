---
interface Props {
  class?: string;
  showTag?: boolean;
}
const { class: className = "", showTag = false } = Astro.props;
---

<a
  href="#inicio"
  class={`group inline-flex items-center gap-2.5 font-display font-black tracking-tight ${className}`}
  aria-label="CyberFix-It, ir al inicio"
>
  <div
    class="relative flex h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-lg bg-dark-purple/30 border border-neon-green/30 p-1 transition-transform duration-300 group-hover:scale-105 group-hover:border-neon-green"
  >
    <img
      src="/logo.svg"
      alt="Logo de CyberFix-It"
      width="32"
      height="32"
      class="h-full w-full object-contain"
      loading="eager"
      decoding="async"
    />
  </div>

  <div class="flex flex-col">
    <span
      class="text-base sm:text-lg font-black tracking-wider text-white transition-colors group-hover:text-neon-green"
    >
      CYBER<span class="text-neon-green">FIX-IT</span>
    </span>
  </div>
</a>
