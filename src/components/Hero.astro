---
import { SITE, WHATSAPP_URL } from "../config";
import RepairCarousel from "./RepairCarousel.astro";
---

<section
  id="inicio"
  class="relative isolate overflow-hidden pt-8 pb-16 sm:pt-14 sm:pb-24 lg:pt-16 lg:pb-28"
>
  <!-- Glows ambientales e imagen de fondo -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 overflow-hidden"
    aria-hidden="true"
  >
    <!-- Imagen de Banner con Opacidad y Desenfoque sutil -->
    <img
      src="/reparaciones/banner1.webp"
      alt=""
      class="h-full w-full object-cover opacity-15 filter blur-[2px]"
    />

    <!-- Overlays de degradado para fusionar el banner con la interfaz oscura -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-tech-black via-tech-black/90 to-tech-black/60"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-b from-tech-black/60 via-transparent to-tech-black"
    >
    </div>

    <!-- Tus Luces/Glows ambientales existentes -->
    <div
      class="absolute -top-24 -left-20 h-72 w-72 sm:h-96 sm:w-96 rounded-full bg-dark-purple/40 blur-[100px]"
    >
    </div>
    <div
      class="absolute top-1/4 -right-24 h-80 w-80 sm:h-[28rem] sm:w-[28rem] rounded-full bg-neon-green/15 blur-[120px]"
    >
    </div>
    <div
      class="absolute bottom-10 left-1/3 h-64 w-64 rounded-full bg-neon-cyan/10 blur-[100px]"
    >
    </div>
    <div class="absolute inset-0 bg-grid-cyber opacity-30"></div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-8">
      <!-- Columna Izquierda: Copy Principal -->
      <div class="lg:col-span-7 text-left">
        <h1
          class="mt-5 font-display text-3xl font-black leading-[1.15] tracking-tight text-white sm:text-5xl lg:text-[3.4rem]"
        >
          Reparación Experta de <span class="text-neon-green text-glow"
            >PC, Laptops</span
          >, Consolas y Celulares
        </h1>

        <h2
          class="mt-5 max-w-2xl text-base leading-relaxed text-white/75 sm:text-lg"
        >
          ¿Tu equipo no enciende, se recalienta o tiene la pantalla rota? En <strong
            >CyberFix-It</strong
          > diagnosticamos sin costo en menos de 24 horas. Repuestos certificados
          y garantía por escrito en cada servicio.
        </h2>

        <div
          class="mt-6 flex flex-wrap gap-2.5 sm:gap-3 text-xs sm:text-sm font-medium text-white/80"
        >
          <div
            class="flex items-center gap-1.5 rounded-md border border-white/10 bg-white/5 px-3 py-1.5"
          >
            <svg
              class="h-4 w-4 text-neon-green"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path>
            </svg>
            Diagnóstico rapido
          </div>
          <div
            class="flex items-center gap-1.5 rounded-md border border-white/10 bg-white/5 px-3 py-1.5"
          >
            <svg
              class="h-4 w-4 text-neon-green"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path>
            </svg>
            Garantía Escrita 30-90 Días
          </div>
          <div
            class="flex items-center gap-1.5 rounded-md border border-white/10 bg-white/5 px-3 py-1.5"
          >
            <svg
              class="h-4 w-4 text-neon-green"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Entrega Express 24-48h
          </div>
        </div>

        <!-- Botones de Acción -->
        <div class="mt-8 flex flex-col gap-3.5 sm:flex-row sm:items-center">
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="chamfer inline-flex items-center justify-center gap-2.5 bg-neon-green px-7 py-4 text-base font-bold text-tech-black transition-all duration-200 hover:scale-[1.02] hover:chamfer-glow focus-visible:scale-105 active:scale-[0.98]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.33 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2Z"
              ></path>
            </svg>
            Cotizar por WhatsApp
          </a>

          <button
            id="btn-explorar-servicios"
            type="button"
            class="chamfer inline-flex items-center justify-center gap-2 border border-white/20 bg-card-bg/40 px-6 py-4 text-base font-bold text-white transition-all duration-200 hover:border-neon-green hover:text-neon-green hover:bg-white/5 active:scale-[0.98]"
          >
            Explorar Servicios
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>

          <script>
            document
              .getElementById("btn-explorar-servicios")
              ?.addEventListener("click", () => {
                const target = document.getElementById("servicios");
                if (!target) return;
                const navbarHeight =
                  (document.querySelector("header, nav") as HTMLElement)
                    ?.offsetHeight ?? 72;
                const top =
                  target.getBoundingClientRect().top +
                  window.scrollY -
                  navbarHeight;
                window.scrollTo({ top, behavior: "smooth" });
              });
          </script>
        </div>

        <!-- Indicador de respuesta rápida -->
        <div class="mt-5 flex items-center gap-2 text-xs text-white/50">
          Respuesta promedio por WhatsApp: <span
            class="font-semibold text-white/90">menos de 15 minutos</span
          >
        </div>
      </div>

      <!-- Columna Derecha: Carrusel Automático -->
      <div class="lg:col-span-5">
        <RepairCarousel />
      </div>
    </div>
  </div>
</section>
