---
const stats = [
  { value: '+100', label: 'Equipos Reparados', detail: 'PC, laptops y consolas', icon: 'M9 3v2M15 3v2M9 19v2M15 19v2M3 9h2M3 15h2M19 9h2M19 15h2M7 7h10v10H7z' },
  { value: '5.0 ★', label: 'Reseñas Verificadas', detail: 'Opiniones en Google', icon: 'M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z' },
  { value: '24h', label: 'Diagnóstico Express', detail: 'Sin compromiso', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
];
---

<section id="confianza" class="relative border-y border-white/5 bg-tech-black py-10 sm:py-14" aria-label="Cifras que respaldan a CyberFix-It">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <dl class="grid grid-cols-1 gap-3 sm:gap-6 sm:grid-cols-3">
      {stats.map((stat, i) => (
        <div
          data-reveal
          style={`transition-delay: ${i * 70}ms`}
          class="relative rounded-xl border border-white/10 bg-card-bg/70 p-4 sm:p-6 text-center backdrop-blur-sm transition-all duration-300 hover:border-neon-green/50 hover:bg-card-bg group"
        >
          <!-- Indicador superior sutil -->
          <div class="mx-auto mb-2 flex h-8 w-8 items-center justify-center rounded-lg bg-dark-purple/30 text-neon-green group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d={stat.icon} />
            </svg>
          </div>

          <dt class="sr-only">{stat.label}</dt>
          <dd class="font-display text-2xl font-black text-neon-green sm:text-3xl lg:text-4xl tracking-tight">
            {stat.value}
          </dd>
          <p class="mt-1 font-display text-xs font-bold uppercase tracking-wider text-white sm:text-sm">
            {stat.label}
          </p>
          <p class="mt-1 text-[11px] text-white/50 hidden sm:block">
            {stat.detail}
          </p>
        </div>
      ))}
    </dl>
  </div>
</section>

