---
import Logo from "./Logo.astro";
import { SITE, WHATSAPP_URL } from "../config";

const links = [
  {
    href: "#servicios",
    label: "Servicios",
    icon: "M9 3v2M15 3v2M9 19v2M15 19v2M3 9h2M3 15h2M19 9h2M19 15h2M7 7h10v10H7z",
  },
  {
    href: "#proceso",
    label: "Cómo funciona",
    icon: "M13 2L3 14h9l-1 8 10-12h-9l1-8z",
  },
  {
    href: "#testimonios",
    label: "Opiniones",
    icon: "M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z",
  },
  {
    href: "#faq",
    label: "Preguntas",
    icon: "M12 22a10 10 0 100-20 10 10 0 000 20zm0-6h.01M12 12a2 2 0 10-2-2",
  },
  {
    href: "#ubicacion",
    label: "Ubicación",
    icon: "M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 110-5 2.5 2.5 0 010 5z",
  },
];
---

<header
  class="sticky top-0 z-50 w-full border-b border-white/10 bg-tech-black/85 backdrop-blur-xl transition-all duration-200"
>
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8"
    aria-label="Navegación principal"
  >
    <Logo showTag={true} />

    <!-- Enlaces de navegación desktop -->
    <ul class="hidden items-center gap-7 lg:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm font-medium text-white/75 transition-colors hover:text-neon-green focus-visible:text-neon-green"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- CTAs y controles móviles -->
    <div class="flex items-center gap-2.5">
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-lg border border-neon-green/30 bg-neon-green/10 px-3 py-1.5 text-xs font-semibold text-neon-green transition-all hover:bg-neon-green hover:text-tech-black lg:hidden"
        aria-label="Contactar por WhatsApp"
      >
        Cotizar
      </a>

      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden lg:inline-flex chamfer-sm items-center gap-2 bg-neon-green px-5 py-2.5 text-sm font-bold text-tech-black transition-all hover:scale-105 hover:chamfer-glow focus-visible:scale-105"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.33 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2Z"
          ></path>
        </svg>
        Cotizar Reparación
      </a>

      <!-- Botón menú hamburguesa -->
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-white/15 bg-white/5 text-white transition-colors hover:border-neon-green hover:text-neon-green lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú de navegación"
      >
        <svg
          id="icon-open"
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="icon-close"
          xmlns="http://www.w3.org/2000/svg"
          class="hidden h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Overlay de fondo -->
  <div
    id="menu-backdrop"
    class="fixed inset-0 top-[60px] z-40 hidden bg-black/80 backdrop-blur-md lg:hidden transition-opacity"
  >
  </div>

  <!-- Menú móvil desplegable -->
  <div
    id="mobile-menu"
    class="fixed inset-x-0 top-[60px] z-50 hidden max-h-[calc(100dvh-60px)] overflow-y-auto border-b border-white/10 bg-tech-black/95 px-4 pt-3 pb-6 shadow-2xl lg:hidden"
  >
    <div
      class="mb-3 px-3 py-2 rounded-lg bg-card-bg/90 border border-white/5 flex items-center justify-between text-xs text-white/70"
    >
      <span
        >Estado: <strong class="text-neon-green font-semibold"
          >Taller Abierto</strong
        ></span
      >
      <span>{SITE.hours}</span>
    </div>

    <ul class="flex flex-col gap-1.5" role="menu">
      {
        links.map((link) => (
          <li role="none">
            <a
              href={link.href}
              role="menuitem"
              class="mobile-link flex items-center gap-3 rounded-lg px-3 py-3 text-base font-medium text-white/85 transition-colors hover:bg-white/5 hover:text-neon-green active:bg-white/10"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                class="h-5 w-5 text-neon-green/80"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d={link.icon}
                />
              </svg>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-4 pt-4 border-t border-white/10 space-y-2.5">
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 rounded-lg bg-neon-green px-4 py-3.5 text-center text-sm font-bold text-tech-black shadow-[0_0_20px_rgba(56,239,157,0.3)] chamfer-sm transition-transform active:scale-[0.98]"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.33 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2Z"
          ></path>
        </svg>
        Cotizar Gratis por WhatsApp
      </a>
      <a
        href={`tel:${SITE.phoneRaw}`}
        class="flex items-center justify-center gap-2 rounded-lg border border-white/15 px-4 py-3 text-center text-sm font-semibold text-white/90 hover:border-white/30"
      >
        Llamar a Servicio Técnico: {SITE.phoneDisplay}
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const backdrop = document.getElementById("menu-backdrop");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  function openMenu() {
    menu?.classList.remove("hidden");
    backdrop?.classList.remove("hidden");
    iconOpen?.classList.add("hidden");
    iconClose?.classList.remove("hidden");
    toggle?.setAttribute("aria-expanded", "true");
  }

  function closeMenu() {
    menu?.classList.add("hidden");
    backdrop?.classList.add("hidden");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
  }

  toggle?.addEventListener("click", (e) => {
    e.preventDefault();
    const isClosed = menu?.classList.contains("hidden");
    if (isClosed) {
      openMenu();
    } else {
      closeMenu();
    }
  });

  backdrop?.addEventListener("click", closeMenu);

  document.querySelectorAll(".mobile-link").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !menu?.classList.contains("hidden")) {
      closeMenu();
    }
  });
</script>
