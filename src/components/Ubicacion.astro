---
import { SITE, WHATSAPP_URL } from "../config";

const benefits = [
  {
    title: "Recepción en Taller",
    desc: "Atención personalizada y diagnóstico express presencial.",
  },
  {
    title: "Retiro a Domicilio",
    desc: "Mensajería segura en toda el área metropolitana.",
  },
];
---

<section
  id="ubicacion"
  class="relative border-t border-white/5 bg-card-bg/40 py-16 sm:py-24"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <h2
        class="mt-4 font-display text-3xl font-black text-white sm:text-4xl lg:text-5xl"
      >
        Ubicación & <span class="text-neon-green text-glow">Horarios</span>
      </h2>
      <p class="mt-4 text-base leading-relaxed text-white/70 sm:text-lg">
        Visítanos en nuestro taller o solicita nuestro servicio express de
        retiro y entrega a domicilio.
      </p>
    </div>

    <div
      class="mt-14 grid grid-cols-1 gap-8 lg:grid-cols-12 items-stretch"
      data-reveal
    >
      <!-- Información del Taller -->
      <div
        class="lg:col-span-5 flex flex-col justify-between rounded-xl border border-white/10 bg-card-bg p-6 sm:p-8 backdrop-blur-md"
      >
        <div>
          <!-- Estado en vivo del taller -->
          <div
            class="flex items-center justify-between border-b border-white/10 pb-4"
          >
            <span
              class="text-xs font-mono uppercase text-white/50 tracking-wider"
              >Taller Central</span
            >
          </div>

          <!-- Dirección -->
          <div class="mt-6 flex items-start gap-3.5">
            <div
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-dark-purple/40 border border-neon-green/30 text-neon-green"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div>
              <h3
                class="font-display text-sm font-bold uppercase tracking-wider text-white"
              >
                Dirección Física
              </h3>
              <p class="mt-1 text-sm font-medium text-white/80">
                {SITE.address}
              </p>
              <p class="text-xs text-white/50">{SITE.city}, {SITE.country}</p>
            </div>
          </div>

          <!-- Horario -->
          <div class="mt-6 flex items-start gap-3.5">
            <div
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-dark-purple/40 border border-neon-green/30 text-neon-green"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div>
              <h3
                class="font-display text-sm font-bold uppercase tracking-wider text-white"
              >
                Horario de Atención
              </h3>
              <p class="mt-1 text-sm font-medium text-white/80">{SITE.hours}</p>
              <p class="text-xs text-white/50">
                Domingos cerrados para mantenimiento de laboratorio
              </p>
            </div>
          </div>

          <!-- Teléfono y WhatsApp -->
          <div class="mt-6 flex items-start gap-3.5">
            <div
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-dark-purple/40 border border-neon-green/30 text-neon-green"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
            </div>
            <div>
              <h3
                class="font-display text-sm font-bold uppercase tracking-wider text-white"
              >
                Línea Directa
              </h3>
              <p class="mt-1 text-sm font-medium text-neon-green">
                {SITE.phoneDisplay}
              </p>
              <p class="text-xs text-white/50">{SITE.email}</p>
            </div>
          </div>
        </div>

        <!-- Botones de Acción de Navegación -->
        <div class="mt-8 pt-6 border-t border-white/10 grid grid-cols-2 gap-3">
          <a
            href={SITE.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 rounded-lg border border-white/20 bg-white/5 px-4 py-3 text-center text-xs font-bold uppercase tracking-wider text-white transition-all hover:border-neon-green hover:text-neon-green active:scale-95"
          >
            <span>Google Maps</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3.5 w-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              ></path>
            </svg>
          </a>

          <a
            href={SITE.wazeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 rounded-lg border border-white/20 bg-white/5 px-4 py-3 text-center text-xs font-bold uppercase tracking-wider text-white transition-all hover:border-neon-cyan hover:text-neon-cyan active:scale-95"
          >
            <span>Waze</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3.5 w-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Tarjeta Interactiva de Mapa y Zonas de Cobertura -->
      <div
        class="lg:col-span-7 flex flex-col justify-between rounded-xl border border-white/10 bg-card-bg p-6 sm:p-8 backdrop-blur-md relative overflow-hidden"
      >
        <div>
          <h3 class="font-display text-xl font-bold text-white">
            Servicio a Domicilio en toda la Ciudad
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-white/70">
            ¿No puedes venir hasta el taller? Nuestro servicio técnico express
            recoge tu equipo en tu hogar u oficina con empaque protegido y
            recibo digital.
          </p>

          <!-- Beneficios de cobertura -->
          <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3">
            {
              benefits.map((b) => (
                <div class="rounded-lg border border-white/5 bg-white/5 p-3.5">
                  <p class="font-display text-xs font-bold text-neon-green">
                    {b.title}
                  </p>
                  <p class="mt-1 text-[11px] text-white/60 leading-normal">
                    {b.desc}
                  </p>
                </div>
              ))
            }
          </div>

          <!-- Mapa de Google Maps -->
          <div
            class="mt-6 relative h-48 sm:h-56 w-full rounded-lg border border-neon-green/30 overflow-hidden bg-[#08080C] shadow-[0_0_20px_rgba(56,239,157,0.15)]"
          >
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d881.0742612025516!2d-79.35980603047018!3d9.079654823737467!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e54abb6adde8c79%3A0xe49158ac58dd16f1!2sCyberFix-It!5e1!3m2!1ses-419!2spa!4v1788912800139!5m2!1ses-419!2spa"
              width="600"
              height="450"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              class="w-full h-full"
              title="Ubicación de CyberFix-It en Tocumen, La Siesta"></iframe>
          </div>
        </div>

        <!-- Botón de consulta de retiro a domicilio -->
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 flex items-center justify-center gap-2 rounded-lg bg-neon-green px-5 py-3.5 text-center text-sm font-bold text-tech-black transition-all hover:chamfer-glow hover:scale-[1.01] active:scale-[0.98]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.33 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2Z"
            ></path>
          </svg>
          Solicitar Retiro a Domicilio por WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>
