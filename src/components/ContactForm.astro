---
// ContactForm.astro
// Formulario de contacto asíncrono para CyberFixIt
// Envía los datos a /api/contact sin recargar la página
---

<section id="contacto" class="relative py-24 overflow-hidden bg-grid-cyber">
  <!-- Glow de fondo decorativo -->
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    aria-hidden="true"
  >
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-[#3B0086]/20 blur-[120px]"></div>
  </div>

  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
    <!-- Encabezado -->
    <div class="mb-10 text-center" data-reveal>
      <p class="mb-2 text-sm font-semibold tracking-[0.25em] uppercase text-[#38EF9D]">
        ▸ Contáctanos
      </p>
      <h2 class="font-orbitron text-3xl font-bold tracking-tight text-white sm:text-4xl">
        ¿Listo para <span class="text-[#38EF9D] text-glow">reparar</span> tu dispositivo?
      </h2>
      <p class="mt-3 text-[#A0A0B0] text-sm leading-relaxed">
        Completa el formulario y te contactaremos a la brevedad.
      </p>
    </div>

    <!-- Tarjeta del formulario -->
    <div
      id="cf-card"
      class="chamfer relative bg-[#12121A] border border-[#2A174E] p-8 sm:p-10 transition-all duration-300"
    >
      <!-- Trazo decorativo superior -->
      <div class="circuit-trace-purple mb-8"></div>

      <!-- ── Estado: Éxito ── -->
      <div
        id="cf-success"
        role="alert"
        aria-live="polite"
        class="hidden flex-col items-center gap-4 py-10 text-center"
      >
        <div class="flex h-16 w-16 items-center justify-center rounded-full bg-[#38EF9D]/15 chamfer-sm">
          <svg class="h-8 w-8 text-[#38EF9D]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h3 class="font-orbitron text-xl font-bold text-white">¡Mensaje enviado!</h3>
        <p class="text-[#A0A0B0] text-sm max-w-xs">
          Recibimos tu solicitud. Te contactaremos muy pronto.
        </p>
        <button
          id="cf-reset"
          class="mt-2 text-xs text-[#38EF9D] underline underline-offset-4 hover:text-white transition-colors"
        >
          Enviar otro mensaje
        </button>
      </div>

      <!-- ── Estado: Error global ── -->
      <div
        id="cf-error-banner"
        role="alert"
        aria-live="assertive"
        class="hidden mb-6 flex items-start gap-3 rounded border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-400"
      >
        <svg class="mt-0.5 h-4 w-4 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <span id="cf-error-text">Ocurrió un error. Por favor intenta de nuevo.</span>
      </div>

      <!-- ── Formulario ── -->
      <form id="contact-form" novalidate class="space-y-6">
        <!-- Nombre -->
        <div class="cf-field">
          <label for="cf-nombre" class="cf-label">
            Nombre completo <span class="text-[#38EF9D]" aria-hidden="true">*</span>
          </label>
          <input
            id="cf-nombre"
            name="nombre"
            type="text"
            required
            autocomplete="name"
            placeholder="Ej. Juan Pérez"
            class="cf-input"
          />
          <p class="cf-hint hidden" id="cf-nombre-error">Por favor ingresa tu nombre.</p>
        </div>

        <!-- Email -->
        <div class="cf-field">
          <label for="cf-email" class="cf-label">
            Correo electrónico <span class="text-[#38EF9D]" aria-hidden="true">*</span>
          </label>
          <input
            id="cf-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="correo@ejemplo.com"
            class="cf-input"
          />
          <p class="cf-hint hidden" id="cf-email-error">Ingresa un correo electrónico válido.</p>
        </div>

        <!-- Teléfono -->
        <div class="cf-field">
          <label for="cf-telefono" class="cf-label">
            Teléfono <span class="text-[#5A5A7A] text-xs font-normal">(opcional)</span>
          </label>
          <input
            id="cf-telefono"
            name="telefono"
            type="tel"
            autocomplete="tel"
            placeholder="Ej. +52 55 1234 5678"
            class="cf-input"
          />
        </div>

        <!-- Mensaje -->
        <div class="cf-field">
          <label for="cf-mensaje" class="cf-label">
            Mensaje <span class="text-[#38EF9D]" aria-hidden="true">*</span>
          </label>
          <textarea
            id="cf-mensaje"
            name="mensaje"
            required
            rows="4"
            placeholder="Describe el problema con tu dispositivo..."
            class="cf-input resize-none"
          ></textarea>
          <p class="cf-hint hidden" id="cf-mensaje-error">Por favor ingresa tu mensaje.</p>
        </div>

        <!-- Botón de envío -->
        <button
          id="cf-submit"
          type="submit"
          class="cf-btn w-full"
        >
          <span id="cf-btn-label">Enviar mensaje</span>
          <svg
            id="cf-spinner"
            class="hidden ml-2 h-4 w-4 animate-spin"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .cf-label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #A0A0B0;
  }

  .cf-input {
    width: 100%;
    background: #0D0D14;
    border: 1px solid #2A174E;
    border-radius: 6px;
    padding: 0.7rem 1rem;
    color: #E7E7EC;
    font-size: 0.92rem;
    font-family: 'Inter', sans-serif;
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
  }

  .cf-input::placeholder { color: #3A3A5C; }

  .cf-input:focus {
    border-color: #38EF9D;
    box-shadow: 0 0 0 3px rgba(56, 239, 157, 0.12);
  }

  .cf-input.is-invalid {
    border-color: #F87171;
    box-shadow: 0 0 0 3px rgba(248, 113, 113, 0.12);
  }

  .cf-hint {
    margin-top: 0.35rem;
    font-size: 0.75rem;
    color: #F87171;
  }

  .cf-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.85rem 2rem;
    background: linear-gradient(135deg, #38EF9D 0%, #00F0FF 100%);
    color: #0A0A0E;
    font-family: 'Orbitron', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
    box-shadow: 0 0 20px rgba(56, 239, 157, 0.3);
  }

  .cf-btn:hover:not(:disabled) {
    opacity: 0.92;
    transform: translateY(-1px);
    box-shadow: 0 0 32px rgba(56, 239, 157, 0.5);
  }

  .cf-btn:active:not(:disabled) { transform: translateY(0); }
  .cf-btn:disabled { opacity: 0.55; cursor: not-allowed; }
</style>

<script>
  const form        = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn   = document.getElementById('cf-submit')       as HTMLButtonElement | null;
  const btnLabel    = document.getElementById('cf-btn-label')    as HTMLElement | null;
  const spinner     = document.getElementById('cf-spinner')      as HTMLElement | null;
  const successBox  = document.getElementById('cf-success')      as HTMLElement | null;
  const errorBanner = document.getElementById('cf-error-banner') as HTMLElement | null;
  const errorText   = document.getElementById('cf-error-text')   as HTMLElement | null;
  const resetBtn    = document.getElementById('cf-reset')        as HTMLElement | null;

  function setLoading(loading: boolean) {
    if (!submitBtn || !btnLabel || !spinner) return;
    submitBtn.disabled = loading;
    btnLabel.textContent = loading ? 'Enviando…' : 'Enviar mensaje';
    spinner.classList.toggle('hidden', !loading);
  }

  function showError(msg: string) {
    if (!errorBanner || !errorText) return;
    errorText.textContent = msg;
    errorBanner.classList.remove('hidden');
    errorBanner.classList.add('flex');
  }

  function hideError() {
    errorBanner?.classList.add('hidden');
    errorBanner?.classList.remove('flex');
  }

  function showSuccess() {
    form?.classList.add('hidden');
    errorBanner?.classList.add('hidden');
    successBox?.classList.remove('hidden');
    successBox?.classList.add('flex');
  }

  function resetForm() {
    form?.reset();
    clearValidation();
    successBox?.classList.add('hidden');
    successBox?.classList.remove('flex');
    form?.classList.remove('hidden');
  }

  interface FieldConfig {
    id: string; errorId: string;
    validate: (val: string) => boolean;
    msg: string;
  }

  const fields: FieldConfig[] = [
    { id: 'cf-nombre',  errorId: 'cf-nombre-error',  validate: (v) => v.trim().length >= 2,                          msg: 'Por favor ingresa tu nombre (mínimo 2 caracteres).' },
    { id: 'cf-email',   errorId: 'cf-email-error',   validate: (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()),    msg: 'Ingresa un correo electrónico válido.' },
    { id: 'cf-mensaje', errorId: 'cf-mensaje-error', validate: (v) => v.trim().length >= 10,                          msg: 'El mensaje debe tener al menos 10 caracteres.' },
  ];

  function validateAll(): boolean {
    let valid = true;
    for (const f of fields) {
      const input   = document.getElementById(f.id) as HTMLInputElement | HTMLTextAreaElement | null;
      const errorEl = document.getElementById(f.errorId);
      if (!input || !errorEl) continue;
      const ok = f.validate(input.value);
      input.classList.toggle('is-invalid', !ok);
      errorEl.textContent = f.msg;
      errorEl.classList.toggle('hidden', ok);
      if (!ok) valid = false;
    }
    return valid;
  }

  function clearValidation() {
    for (const f of fields) {
      document.getElementById(f.id)?.classList.remove('is-invalid');
      document.getElementById(f.errorId)?.classList.add('hidden');
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();
    if (!validateAll()) return;
    setLoading(true);

    const fd = new FormData(form!);
    const payload = {
      nombre:   (fd.get('nombre')   as string).trim(),
      email:    (fd.get('email')    as string).trim(),
      telefono: ((fd.get('telefono') as string | null) ?? '').trim(),
      mensaje:  (fd.get('mensaje')  as string).trim(),
    };

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        showSuccess();
      } else {
        const data = await res.json().catch(() => ({}));
        showError((data as { error?: string }).error ?? `Error ${res.status}: No se pudo enviar el mensaje.`);
      }
    } catch {
      showError('Sin conexión o error de red. Verifica tu internet e intenta de nuevo.');
    } finally {
      setLoading(false);
    }
  });

  resetBtn?.addEventListener('click', resetForm);
</script>
