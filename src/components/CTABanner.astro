---
import { SITE, WHATSAPP_URL } from "../config";
---

<section
  id="contacto"
  class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8"
>
  <div
    data-reveal
    class="relative overflow-hidden rounded-2xl border border-neon-green/30 bg-gradient-to-br from-[#1b053a] via-[#120826] to-[#0A0A0E] px-6 py-12 text-center sm:px-12 sm:py-16 shadow-[0_0_50px_rgba(59,0,134,0.3)]"
  >
    <!-- Glows decorativos de fondo -->
    <div
      class="pointer-events-none absolute -top-24 right-0 h-80 w-80 rounded-full bg-neon-green/20 blur-[110px]"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -bottom-24 left-0 h-80 w-80 rounded-full bg-neon-cyan/20 blur-[110px]"
      aria-hidden="true"
    >
    </div>
    <div class="absolute inset-0 bg-grid-cyber opacity-30"></div>

    <div class="relative z-10 mx-auto max-w-3xl">
      <h2
        class="mt-2 font-display text-3xl font-black text-white sm:text-4xl lg:text-5xl tracking-tight"
      >
        ¿Tu equipo está fallando? <br class="hidden sm:inline" />
        <span class="text-neon-green text-glow">No lo dejes morir.</span>
      </h2>

      <p
        class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-white/80 sm:text-lg"
      >
        Escríbenos ahora mismo y recibe tu diagnóstico en menos de 24
        horas. Sin letra pequeña, con repuestos de calidad.
      </p>

      <!-- Botones principales con adaptación móvil perfecta -->
      <div
        class="mt-8 flex flex-col items-center justify-center gap-3.5 sm:flex-row"
      >
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="chamfer-sm flex w-full sm:w-auto items-center justify-center gap-2.5 bg-neon-green px-8 py-4 text-base font-bold text-tech-black transition-all duration-200 hover:scale-105 hover:chamfer-glow active:scale-[0.98]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.33 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2Z"
            ></path>
          </svg>
          Escribir por WhatsApp
        </a>

        <a
          href={`tel:${SITE.phoneRaw}`}
          class="chamfer-sm flex w-full sm:w-auto items-center justify-center gap-2 border border-white/20 bg-white/5 px-7 py-4 text-base font-bold text-white transition-all duration-200 hover:border-neon-green hover:text-neon-green active:scale-[0.98]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 text-neon-green"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            ></path>
          </svg>
          Llamar: {SITE.phoneDisplay}
        </a>
      </div>

      <!-- Micro-garantías debajo del CTA -->
      <div
        class="mt-8 flex flex-wrap items-center justify-center gap-6 text-xs text-white/60"
      >
        <span class="flex items-center gap-1.5">
          <svg
            class="h-4 w-4 text-neon-green"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path>
          </svg>
          Garantía por escrito de 30 a 90 días
        </span>
        <span class="flex items-center gap-1.5">
          <svg
            class="h-4 w-4 text-neon-green"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path>
          </svg>
          Respuesta en menos de 15 min
        </span>
      </div>
    </div>
  </div>
</section>
